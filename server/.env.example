PORT=5000
NODE_ENV=development

# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_key_change_this

# MongoDB (Atlas connection string, or mongodb://localhost:27017/nexus for local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexus?retryWrites=true&w=majority

# Cloudinary (file attachments) — from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gmail (OTP emails). Only required when NODE_ENV=production;
# in development the OTP is printed to the server console instead.
# Create an App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Frontend origins allowed to call the API / connect via Socket.io (comma-separated)
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
